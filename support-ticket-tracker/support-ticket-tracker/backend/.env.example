# Copy this file to .env and fill in your values. Never commit .env.

# MySQL (create the database first: CREATE DATABASE ticketdb;)
DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/ticketdb
# For a quick run without MySQL you can use: DATABASE_URL=sqlite:///./dev.db

# JWT - use a long random string, e.g. python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Free LLM (Groq shown). Leave LLM_API_KEY empty to use only the rule-based triage.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

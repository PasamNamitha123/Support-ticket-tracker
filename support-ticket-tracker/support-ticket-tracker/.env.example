# Copy to .env (same folder as docker-compose.yml) and fill in. Never commit .env.
# Use letters and numbers only in the password (it is placed inside a connection URL).
MYSQL_ROOT_PASSWORD=ChangeMe123
SECRET_KEY=replace-with-a-long-random-string

# Optional free LLM key (Groq shown). Leave empty to use rule-based triage only.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
